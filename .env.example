# Local placeholders only. scripts/dev.py creates missing .env without overwriting it.
COMPOSE_PROJECT_NAME=floatchat-dev
API_PORT=8000
WEB_PORT=5173
DB_ADMIN_PASSWORD=GENERATE_LOCALLY
DB_APP_PASSWORD=GENERATE_LOCALLY
DATABASE_URL=postgresql://floatchat_app:${DB_APP_PASSWORD}@db:5432/floatchat
DATABASE_ADMIN_URL=postgresql://floatchat_admin:${DB_ADMIN_PASSWORD}@db:5432/floatchat
DB_QUERY_PASSWORD=GENERATE_LOCALLY
QUERY_DATABASE_URL=postgresql://floatchat_query:${DB_QUERY_PASSWORD}@db:5432/floatchat
REDIS_URL=redis://redis:6379/0
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=floatchat-app
OBJECT_STORAGE_SECRET_KEY=GENERATE_LOCALLY
OBJECT_STORAGE_BUCKET=floatchat-dev
OBJECT_STORAGE_REGION=us-east-1
MINIO_ROOT_USER=floatchat-admin
MINIO_ROOT_PASSWORD=GENERATE_LOCALLY
# Server-side proxy configuration, never browser secrets.
API_PROXY_TARGET=http://api:8000
